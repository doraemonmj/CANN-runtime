# PTO-ISA Kernel: Vector Scale
#
# Computes: output[i] = input[i] * scale
#
# This is pseudo-assembly showing AICORE instruction flow.
# Real kernels are written in TIK (Python) or Ascend C.

# ============================================================
# Kernel Header
# ============================================================

.kernel vec_scale
.args {
    input:   ptr<f32>    # GM pointer to input array
    output:  ptr<f32>    # GM pointer to output array
    count:   i32         # Number of elements
    scale:   f32         # Scale factor
}

# ============================================================
# Block Distribution
# ============================================================

# Get block information (injected by runtime)
SCALAR  r0 = GET_BLOCK_IDX()      # r0 = my block index (0 to N-1)
SCALAR  r1 = GET_BLOCK_DIM()      # r1 = total number of blocks

# Calculate my portion
SCALAR  r2 = args.count           # r2 = total elements
SCALAR  r3 = r2 / r1              # r3 = elements per block (chunk)
SCALAR  r4 = r0 * r3              # r4 = my start offset

# Calculate addresses
SCALAR  r5 = args.input + r4 * 4  # r5 = input address (float = 4 bytes)
SCALAR  r6 = args.output + r4 * 4 # r6 = output address

# ============================================================
# Main Processing Loop
# ============================================================

# Process chunk in tiles of 256 elements (fits UB nicely)
SCALAR  r7 = 0                    # r7 = tile offset
SCALAR  TILE_SIZE = 256

.loop_start:
    # Check if done
    CMP     r7, r3
    JGE     .loop_end

    # Calculate tile size (handle last partial tile)
    SCALAR  r8 = r3 - r7          # remaining elements
    SCALAR  r9 = MIN(r8, TILE_SIZE)

    # --------------------------------------------------------
    # Stage 1: Load from HBM to UB
    # --------------------------------------------------------
    # DMA engine handles HBM -> L2 -> L1 -> UB transfer

    SCALAR  src = r5 + r7 * 4     # source address in GM
    DMA_LOAD UB[0:r9], GM[src], r9 * 4
    WAIT_DMA                      # Wait for load to complete

    # --------------------------------------------------------
    # Stage 2: Vector multiply (all elements in UB)
    # --------------------------------------------------------
    # Vector unit processes 256 floats per cycle

    SCALAR  scale_val = args.scale
    VMULS   UB[0:r9], UB[0:r9], scale_val
    WAIT_VEC                      # Wait for vector op to complete

    # --------------------------------------------------------
    # Stage 3: Store from UB to HBM
    # --------------------------------------------------------

    SCALAR  dst = r6 + r7 * 4     # destination address in GM
    DMA_STORE GM[dst], UB[0:r9], r9 * 4
    WAIT_DMA                      # Wait for store to complete

    # Advance to next tile
    ADD     r7, r7, TILE_SIZE
    JMP     .loop_start

.loop_end:
    RET

# ============================================================
# Notes
# ============================================================
#
# Pipeline Optimization:
#   In production kernels, we overlap stages using double buffering:
#
#   While processing tile N:
#     - Load tile N+1 (DMA)
#     - Compute tile N (Vector)
#     - Store tile N-1 (DMA)
#
# Memory Hierarchy:
#   HBM (32GB) -> L2 (192MB) -> L1 (1MB) -> UB (256KB)
#
#   DMA_LOAD implicitly goes through L2 and L1
#   Explicit L1 staging allows prefetching for tiled algorithms
#
# Vector Width:
#   VMULS operates on up to 256 floats per instruction
#   Smaller tiles still use full vector width (masking unused lanes)
